# Sitio público y medición de visitas con Google Tag Manager
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GTM_ID=

# Acceso al panel de administración: origen, hash de contraseña y secreto de sesión
APP_ORIGIN=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Precios del menú en Google Sheets: URL del script publicado y secreto compartido
MENU_SHEETS_SCRIPT_URL=
MENU_SHEETS_SECRET=

# Redis como alternativa para los precios: URL, tokens de escritura y lectura, y clave de almacenamiento
MENU_REDIS_URL=
MENU_REDIS_TOKEN=
MENU_REDIS_READ_TOKEN=
MENU_PRICE_KEY=

# Facturas en Google Sheets: ID del archivo, períodos separados por comas y acceso al script
GOOGLE_SHEET_ID=
GOOGLE_SHEET_PERIODS=
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
